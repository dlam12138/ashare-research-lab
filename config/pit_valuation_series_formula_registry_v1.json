  "formulas": [
    {
      "metric_id": "PE_A_TTM",
      "formula_id": "pe-a-ttm-v1",
      "version": 1,
      "numerator_role": "A_share_close",
      "numerator_instant_or_duration": "instant",
      "numerator_unit": "CNY/share",
      "numerator_scope": "SSE_A_SHARE_unadjusted_close",
      "denominator_roles": [
        {
          "role": "PIT_TTM_basic_EPS",
          "instant_or_duration": "duration",
          "unit": "CNY/share",
          "definition": "PIT_TTM_parent_net_profit / PIT_TTM_weighted_average_total_ordinary_shares"
        }
      ],
      "required_input_fact_roles": [
        "net_profit_attributable_to_parent",
        "weighted_average_total_ordinary_shares"
      ],
      "ttm_construction": "annual: annual(Y); Q1/H1/Q3: annual(Y-1) + cumulative(Y,P) - cumulative(Y-1,P)",
      "share_basis": "TTM_weighted_average_total_ordinary_shares",
      "share_basis_rule": "constant weighted-average shares when share-continuity proof trusted and count constant over the whole TTM duration",
      "share_continuity_proof_required": "r4d1-share-continuity-constancy-v1",
      "instant_or_duration": "duration",
      "unit": "dimensionless",
      "valid_domain_rule": "PIT_TTM_parent_net_profit > 0; ratio null and status=nonpositive_earnings when <= 0",
      "rounding_contract": "ROUND_HALF_EVEN; no premature quantize of intermediate values",
      "prohibited_fallbacks": [
        "latest annual earnings proxy for TTM",
        "close-percentile as valuation percentile",
        "negative PE retained or treated as extremely-low valuation",
        "third-party PE",
        "current share count backfill for weighted-average"
      ]
    },
    {
      "metric_id": "PB_A_MRQ",
      "formula_id": "pb-a-mrq-v1",
      "version": 1,
      "numerator_role": "A_share_close",
      "numerator_instant_or_duration": "instant",
      "numerator_unit": "CNY/share",
      "numerator_scope": "SSE_A_SHARE_unadjusted_close",
      "denominator_roles": [
        {
          "role": "PIT_parent_BVPS",
          "instant_or_duration": "instant",
          "unit": "CNY/share",
          "definition": "latest_visible_parent_equity / matching_period_end_total_ordinary_shares"
        }
      ],
      "required_input_fact_roles": [
        "equity_attributable_to_parent",
        "total_ordinary_shares_at_period_end"
      ],
      "mrq_construction": "latest visible parent equity at trade date",
      "share_basis": "matching_period_end_total_ordinary_shares",
      "share_basis_rule": "equity and period-end shares must share the same period_end and the same PIT-visible reporting context; never independently pick latest equity and latest arbitrary shares",
      "share_continuity_proof_required": "r4d1-share-continuity-constancy-v1",
      "instant_or_duration": "instant",
      "unit": "dimensionless",
      "valid_domain_rule": "equity > 0 and shares > 0; ratio null with explicit status otherwise",
      "rounding_contract": "ROUND_HALF_EVEN; no premature quantize of intermediate values",
      "prohibited_fallbacks": [
        "latest year-end equity proxy for MRQ",
        "unmatched equity/share period-end context",
        "third-party PB",
        "current share count backfill for period-end shares"
      ]
    },
    {
      "metric_id": "PS_A_TTM",
      "formula_id": "ps-a-ttm-v1",
      "version": 1,
      "numerator_role": "A_share_close",
      "numerator_instant_or_duration": "instant",
      "numerator_unit": "CNY/share",
