          "instant_or_duration": "duration",
          "unit": "CNY/share",
          "definition": "PIT_TTM_revenue / total_ordinary_shares_effective_on_trade_date"
        }
      ],
      "required_input_fact_roles": [
        "revenue",
        "total_ordinary_shares_at_period_end"
      ],
      "ttm_construction": "annual: annual(Y); Q1/H1/Q3: annual(Y-1) + cumulative(Y,P) - cumulative(Y-1,P)",
      "share_basis": "total_ordinary_shares_effective_on_trade_date",
      "share_basis_rule": "shares effective on the trade date; share_effective_from <= trade_date; forward/nearest prohibited",
      "share_continuity_proof_required": "r4d1-share-continuity-constancy-v1",
      "instant_or_duration": "duration",
      "unit": "dimensionless",
      "valid_domain_rule": "revenue > 0 and shares > 0; ratio null with explicit status otherwise",
      "rounding_contract": "ROUND_HALF_EVEN; no premature quantize of intermediate values",
      "prohibited_fallbacks": [
        "latest annual revenue proxy for TTM",
        "close-percentile as valuation percentile",
        "third-party PS",
        "current share count backfill"
      ]
    }
