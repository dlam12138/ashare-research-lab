{
  "methodology_id": "value_evaluation_methodology_earnings_quality_v1",
  "schema_version": "1.0",
  "version": "1",
  "extends": "value_evaluation_methodology_v1",
  "score_eligible": false,
  "decimal": {
    "precision": 28,
    "canonical_quantum": "0.000000000001",
    "rounding": "ROUND_HALF_EVEN"
  },
  "metrics": [
    {
      "metric_id": "net_profit_excluding_non_recurring_yoy",
      "display_name_zh": "扣非归母净利润同比",
      "formula": "(current / prior) - 1",
      "input_concepts": ["net_profit_excluding_non_recurring"],
      "unit": "ratio",
      "supports": "比较扣非归母净利润的年度变化",
      "does_not_support": "不能证明利润可持续，也不是企业好坏判断",
      "industry_context_required": true,
      "multi_year_trend_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "cyclical_company_limitation": "周期高低点会放大同比",
      "score_eligible": false
    },
    {
      "metric_id": "gross_profit",
      "display_name_zh": "毛利润（营业收入减营业成本）",
      "formula": "revenue - operating_cost",
      "input_concepts": ["revenue", "operating_cost"],
      "unit": "万元",
      "supports": "展示收入扣除营业成本后的透明金额",
      "does_not_support": "不能自动形成盈利质量好坏结论",
      "industry_context_required": true,
      "multi_year_trend_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "cyclical_company_limitation": "受油气价格、炼化价差和业务结构影响",
      "score_eligible": false
    },
    {
      "metric_id": "gross_margin",
      "display_name_zh": "毛利率",
      "formula": "(revenue - operating_cost) / revenue",
      "input_concepts": ["revenue", "operating_cost"],
      "unit": "ratio",
      "supports": "展示营业收入和营业成本口径下的毛利水平",
      "does_not_support": "单年变化不能判断企业好坏",
      "industry_context_required": true,
      "multi_year_trend_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "cyclical_company_limitation": "必须结合油价、炼化价差和业务结构",
      "score_eligible": false
    },
    {
      "metric_id": "operating_profit_margin",
      "display_name_zh": "营业利润率",
      "formula": "operating_profit / revenue",
      "input_concepts": ["operating_profit", "revenue"],
      "unit": "ratio",
      "supports": "展示营业利润相对营业收入的水平",
      "does_not_support": "不代表资本回报、EBIT margin 或分部利润率",
      "industry_context_required": true,
      "multi_year_trend_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "cyclical_company_limitation": "周期与业务结构会改变指标解释",
      "score_eligible": false
    }
  ],
  "score_blockers": [
    "missing_cross_cycle_history",
    "missing_industry_benchmark",
    "missing_non_recurring_fact",
    "missing_capital_return_facts",
    "missing_financial_safety_facts",
    "no_approved_threshold_or_weight_contract"
  ],
  "references": [
    "CFA Institute Financial Statement Analysis",
    "CFA Institute Evaluating Quality of Financial Reports",
    "财政部企业会计准则",
    "Stephen H. Penman, Financial Statement Analysis and Security Valuation"
  ]
}
