  "schema": "roic_formula_dependency_graph_v1",
  "version": "1",
  "formula_candidate": "B_operating_profit_bridge_financing_view",
  "primary_formula": {
    "operating_earnings_before_tax": "operating_profit + finance_cost_adjustment - investment_income - fair_value_net_change - asset_disposal_gain_loss",
    "finance_cost_composition": "finance_cost_excluding_lease_interest + lease_interest_expense",
    "nopat": "operating_earnings_before_tax - operating_tax_expense",
    "closing_invested_capital": "parent_equity + non_controlling_interest + interest_bearing_debt_total - qualifying_non_operating_assets",
    "average_invested_capital": "(opening_invested_capital + closing_invested_capital) / 2"
  },
  "finance_lease_composition": {
    "mode": "lease_included_in_composite",
    "composition_formula": "finance_cost_adjustment = finance_cost_excluding_lease_interest + lease_interest_expense",
    "component_role_ids": ["nopat.finance_cost_excluding_lease_interest", "nopat.lease_interest_expense"],
    "component_contribution_signs": {"nopat.finance_cost_excluding_lease_interest": 1, "nopat.lease_interest_expense": 1},
    "final_formula_contribution_roles": ["nopat.finance_cost_adjustment"],
    "no_double_count_invariant": "components never contribute again after finance_cost_adjustment",
    "source_note_requirements": "official finance-cost and lease notes must reconcile the two signed components to the composite",
    "missing_component_behavior": "parent_methodology_unresolved_or_unready; no manual plug"
  },
  "invariants": [
    "finance_cost_adjustment_is_the_only_independent_finance_formula_contribution",
    "lease_interest_expense_is_included_in_finance_cost_adjustment_and_never_added_again",
    "all_composite_components_must_be_ready_before_the_parent_is_ready",
    "investment_income_fair_value_and_asset_disposal_are_independent_non_overlapping_adjustments",
    "other_non_operating_income_expense_is_secondary_because_it_is_outside_CAS_operating_profit",
    "operating_tax_expense_has_no_rate_or_net_profit_fallback",
    "methodology_choices_are_not_facts_and_derivations_are_not_directly_acquired"
  ],
