  ],
  "metrics": [
    {
      "metric_id": "revenue_yoy",
      "methodology_version": "1.0",
      "dimension": "operating_stability",
      "interpretation_role": "描述同口径营业收入相对上一年度的方向和幅度。",
      "formula": "(current_revenue / prior_revenue) - 1",
      "input_concepts": ["revenue"],
      "unit": "ratio",
      "supports_questions": [
        "本年营业收入相对上年如何变化？",
        "收入变化是否与利润及现金流变化同向？"
      ],
      "does_not_support": [
        "不能单独证明增长可持续或企业质量优秀。",
        "不能区分价格、销量、汇率、并购和会计口径变化的贡献。"
      ],
      "industry_context_required": true,
      "multi_year_required": true,
      "peer_comparison_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "score_eligible": false,
      "score_blockers": [
        "单一年份同比不足以形成稳定性判断",
        "缺少价格与销量拆分、行业周期和同行基准"
      ],
      "references": ["cfa_fsa", "mof_cas28", "penman_fsa_sv"]
    },
    {
      "metric_id": "net_profit_attributable_to_parent_yoy",
      "methodology_version": "1.0",
      "dimension": "profitability_quality",
      "interpretation_role": "描述归属于母公司股东净利润的年度变化。",
      "formula": "(current_net_profit_attributable_to_parent / prior_net_profit_attributable_to_parent) - 1",
      "input_concepts": ["net_profit_attributable_to_parent"],
      "unit": "ratio",
      "supports_questions": [
        "归母净利润相对上年如何变化？",
        "利润变化与收入及经营现金流变化是否一致？"
      ],
      "does_not_support": [
        "不能识别非经常性损益或会计估计影响。",
        "不能单独证明盈利质量、资本回报或估值吸引力。"
      ],
      "industry_context_required": true,
      "multi_year_required": true,
      "peer_comparison_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "score_eligible": false,
      "score_blockers": [
        "缺少扣非归母净利润和非经常性损益",
        "单年同比受基数、周期和重列影响"
      ],
      "references": ["cfa_reporting_quality", "mof_cas28", "penman_fsa_sv"]
    },
    {
      "metric_id": "operating_cash_flow_yoy",
      "methodology_version": "1.0",
      "dimension": "cash_flow_quality",
      "interpretation_role": "描述经营活动产生的现金流量净额的年度变化。",
      "formula": "(current_operating_cash_flow / prior_operating_cash_flow) - 1",
      "input_concepts": ["operating_cash_flow"],
      "unit": "ratio",
      "supports_questions": [
        "经营现金净流入相对上年如何变化？",
        "现金流变化是否与收入、利润变化同向？"
      ],
      "does_not_support": [
        "不能单独区分营运资本时点、商品价格和经营效率影响。",
        "不能代表完整自由现金流或偿债能力。"
      ],
      "industry_context_required": true,
      "multi_year_required": true,
      "peer_comparison_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "score_eligible": false,
      "score_blockers": [
        "单年现金流波动可能主要来自营运资本和周期",
        "缺少现金流附注及行业历史基准"
      ],
      "references": ["ifrs_ias7", "mof_cas31", "cfa_reporting_quality"]
    },
    {
      "metric_id": "operating_cash_flow_to_attributable_net_profit",
      "methodology_version": "1.0",
      "dimension": "cash_flow_quality",
      "interpretation_role": "比较经营现金流与归母净利润的量级，作为现金实现的描述性线索。",
      "formula": "operating_cash_flow / net_profit_attributable_to_parent",
      "input_concepts": [
        "operating_cash_flow",
        "net_profit_attributable_to_parent"
      ],
      "unit": "ratio",
      "supports_questions": [
        "经营现金流与归母净利润的量级是否长期背离？",
        "现金实现关系是否需要进一步检查营运资本和非现金项目？"
      ],
      "does_not_support": [
        "不能以 1 作为机械的绝对好坏分界。",
        "分子与分母归属范围并不完全相同，不能单独证明利润质量。"
      ],
      "industry_context_required": true,
      "multi_year_required": true,
      "peer_comparison_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "score_eligible": false,
      "score_blockers": [
        "需解释营运资本、税费、利息、少数股东和非现金项目",
        "分母接近零或为负时比率失真"
      ],
      "references": ["cfa_reporting_quality", "ifrs_ias7", "penman_fsa_sv"]
    },
    {
      "metric_id": "cash_based_free_cash_flow_proxy",
      "methodology_version": "1.0",
      "dimension": "cash_flow_quality",
      "interpretation_role": "用经营现金流减去购建长期资产现金支出，描述一个可复算的现金余量代理。",
      "formula": "operating_cash_flow - cash_paid_for_fixed_assets",
      "input_concepts": [
        "operating_cash_flow",
        "cash_paid_for_fixed_assets"
      ],
      "unit": "万元",
      "supports_questions": [
        "在该狭义现金支出口径后，年度现金余量方向与量级如何？",
        "该代理的多年变化是否与周期和投资阶段一致？"
      ],
      "does_not_support": [
        "不是完整 FCFF 或 FCFE。",
        "不能区分维持性与扩张性支出，也未穷尽所有资本性现金流。"
      ],
      "industry_context_required": true,
      "multi_year_required": true,
      "peer_comparison_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "score_eligible": false,
      "score_blockers": [
        "资本性现金流口径不完整",
        "未区分维持性和增长性投资",
        "周期企业单年余量可能失真"
      ],
      "references": ["ifrs_ias7", "damodaran_investment_valuation", "mckinsey_valuation"]
    },
    {
      "metric_id": "cash_paid_for_fixed_assets_to_revenue",
      "methodology_version": "1.0",
      "dimension": "cash_flow_quality",
      "interpretation_role": "描述购建长期资产现金支出相对营业收入的量级。",
      "formula": "cash_paid_for_fixed_assets / revenue",
      "input_concepts": ["cash_paid_for_fixed_assets", "revenue"],
      "unit": "ratio",
      "supports_questions": [
        "长期资产现金支出相对收入的年度量级如何？",
        "该量级是否随周期和投资计划发生持续变化？"
      ],
      "does_not_support": [
        "不能无条件等同完整资本开支强度。",
        "不能单独判断投资效率、项目回报或企业质量。"
      ],
      "industry_context_required": true,
      "multi_year_required": true,
      "peer_comparison_required": true,
      "pit_required": true,
      "restatement_sensitive": true,
      "score_eligible": false,
      "score_blockers": [
        "现金流量表项目不等于完整资本开支定义",
        "需结合行业资产强度、周期和投资阶段"
      ],
      "references": ["ifrs_ias7", "mckinsey_valuation", "financetoolkit"]
    }
  ],
