{
  "schema": "value_dimension_scoring_transform_registry_v2",
  "version": "2.0",
  "frozen_date": "2026-08-04",
  "owner": "M2 Stage 2K.1R3 pure-function transform registry closeout",
  "non_production": true,
  "score_eligible": false,
  "layer_separation": {
    "layer_1": "upstream records -> financial/valuation metric values (this registry)",
    "layer_2": "metric values -> dimension component scores (stage2k piecewise absolute contract)",
    "note": "layer 1 and layer 2 are distinct; the validator can tell whether it is validating an input metric or a score transform"
  },
  "transforms": {
    "gross_margin_v1": {"version": "1.0", "formula": "(revenue - operating_cost) / revenue", "output_unit": "ratio", "output_domain": "ratio_gte_0", "operands": ["revenue", "operating_cost"]},
    "operating_margin_v1": {"version": "1.0", "formula": "operating_profit / revenue", "output_unit": "ratio", "output_domain": "ratio", "operands": ["operating_profit", "revenue"]},
    "np_yoy_v1": {"version": "1.0", "formula": "(np_2025 - np_2024) / np_2024", "output_unit": "ratio", "output_domain": "ratio", "operands": ["net_profit_attributable_to_parent:2025", "net_profit_attributable_to_parent:2024"]},
    "ocf_to_net_profit_v1": {"version": "1.0", "formula": "operating_cash_flow / net_profit_attributable_to_parent", "output_unit": "ratio", "output_domain": "ratio", "operands": ["operating_cash_flow", "net_profit_attributable_to_parent"]},
    "roe_v1": {"version": "1.0", "formula": "np / avg(equity_2024, equity_2025)", "output_unit": "ratio", "output_domain": "ratio", "operands": ["net_profit_attributable_to_parent", "equity_attributable_to_parent:2025", "equity_attributable_to_parent:2024"]},
    "roa_v1": {"version": "1.0", "formula": "net_profit / avg(total_assets_2024, total_assets_2025)", "output_unit": "ratio", "output_domain": "ratio", "operands": ["net_profit", "total_assets:2025", "total_assets:2024"]},
    "asset_liability_v1": {"version": "1.0", "formula": "total_liabilities / total_assets", "output_unit": "ratio", "output_domain": "ratio", "operands": ["total_liabilities", "total_assets"]},
    "cash_coverage_v1": {"version": "1.0", "formula": "cash / sum(short_term + current_portion + long_term + bonds + lease)", "output_unit": "ratio", "output_domain": "ratio", "operands": ["cash_and_cash_equivalents", "short_term_borrowings", "current_portion_of_interest_bearing_non_current_liabilities", "long_term_borrowings", "bonds_payable", "lease_liabilities"]},
    "payout_ratio_v1": {"version": "1.0", "formula": "total_cash_dividend / net_profit_attributable_to_parent", "output_unit": "ratio", "output_domain": "ratio", "operands": ["cash_dividend_total", "net_profit_attributable_to_parent"]},
    "sum_dps_v1": {"version": "1.0", "formula": "sum(event.cash_dividend_per_share)", "output_unit": "CNY", "output_domain": "cny_gte_0", "operands": ["cash_dividend_per_share"]},
    "ocf_dividend_coverage_v1": {"version": "1.0", "formula": "operating_cash_flow / total_cash_dividend", "output_unit": "ratio", "output_domain": "ratio", "operands": ["operating_cash_flow", "cash_dividend_total"]},
    "fcf_dividend_coverage_v1": {"version": "1.0", "formula": "(operating_cash_flow - capex) / total_cash_dividend", "output_unit": "ratio", "output_domain": "ratio", "operands": ["operating_cash_flow", "capital_expenditure", "cash_dividend_total"]},
    "risk_observed_count_v1": {"version": "1.0", "formula": "count(risk_slots with observed status)", "output_unit": "count", "output_domain": "count_gte_0", "operands": ["risk_slot"]},
    "risk_missing_count_v1": {"version": "1.0", "formula": "count(risk_slots with missing/not_observed status)", "output_unit": "count", "output_domain": "count_gte_0", "operands": ["risk_slot"]},
    "gap_count_v1": {"version": "1.0", "formula": "count(gap records)", "output_unit": "count", "output_domain": "count_gte_0", "operands": ["gap_record"]},
    "categorical_pass_v1": {"version": "1.0", "formula": "pass through categorical value", "output_unit": "categorical", "output_domain": "categorical_enum", "operands": ["record"]}
  },
  "prohibited_fallbacks": [
    "capsule_transform_inputs",
    "manual_constant",
    "zero_fill",
    "partial_dividend_substitution",
    "hidden_fallback"
  ]
}